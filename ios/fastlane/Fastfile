# Used by .github/workflows/release.yml to ship a tagged release to the App Store.
#
# Required environment (repository secrets in CI):
#   APPLE_TEAM_ID              10-character team ID
#   ASC_KEY_ID, ASC_ISSUER_ID  App Store Connect API key (role: App Manager or Admin)
#   ASC_KEY_P8_BASE64          the key's .p8 file, base64-encoded
#   DIST_CERT_P12_PATH         Apple Distribution certificate + private key (.p12)
#   DIST_CERT_PASSWORD         its password
# Plus, from the workflow:
#   APP_VERSION                e.g. 1.2.0 (the tag without a leading "v")
#   BUILD_NUMBER               monotonically increasing integer
#   RELEASE_NOTES              "What's New" text

default_platform(:ios)

platform :ios do
  desc "Build, upload, and submit for App Store review (released automatically when approved)"
  lane :release do
    setup_ci # temporary keychain; no-op outside CI

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )

    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_P12_PATH"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # Fetches (or creates) the App Store provisioning profile for the bundle ID.
    get_provisioning_profile(api_key: api_key)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Manual signing for the app target only. Passing a profile on the
    # xcodebuild command line would also apply it to the Swift package
    # targets (AMSMB2, CopyCore), which fails. CI checkouts are throwaway,
    # so editing the project here is fine.
    update_code_signing_settings(
      path: "CopyPhotos.xcodeproj",
      targets: ["CopyPhotos"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    build_app(
      project: "CopyPhotos.xcodeproj",
      scheme: "CopyPhotos",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { "com.copyphotos.app" => profile_name },
      },
      xcargs: "MARKETING_VERSION=#{ENV.fetch('APP_VERSION')} CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}",
      output_directory: "build",
      output_name: "CopyPhotos.ipa",
    )

    # Creates the App Store version if needed, sets "What's New", waits for the
    # build to finish processing, attaches it, and submits it for review.
    upload_to_app_store(
      api_key: api_key,
      ipa: "build/CopyPhotos.ipa",
      app_version: ENV.fetch("APP_VERSION"),
      release_notes: { "default" => ENV.fetch("RELEASE_NOTES") },
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true, # no interactive HTML preview
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false },
    )
  end
end
